{
  "name": "aqx-trader-e2e",
  "version": "1.0.0",
  "description": "Playwright end-to-end tests for Aquariux WebTrader, covering order placement, position management, and trading history",
  "main": "index.js",
  "scripts": {
    "setup": "pnpm install && playwright install chromium firefox",
    "typecheck": "tsc --noEmit",
    "rules:check": "node scripts/rule-engine.js",
    "del:logs": "node scripts/clean-reports.mjs",
    "del:auth": "node scripts/clean-auth.mjs",
    "validate": "pnpm typecheck && pnpm rules:check",
    "test:prepare": "pnpm validate && pnpm del:logs && pnpm del:auth",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:p0": "playwright test --grep @P0",
    "report:generate": "allure generate reports/allure-results -o reports/allure-report --clean",
    "report:open": "allure open reports/allure-results",
    "report:watch": "allure watch reports/allure-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "allure": "^3.33.0",
    "allure-playwright": "^3.15.0",
    "dotenv": "^18.0.10",
    "typescript": "^7.0.2"
  }
}
